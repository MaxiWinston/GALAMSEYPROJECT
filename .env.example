# Optional: Mapbox GL raster tiles (dark style). Without this, OpenStreetMap tiles are used (no key).
# VITE_MAPBOX_TOKEN=pk.ey...

# ── Firebase Realtime Database (recommended backend) ──────────────────────────
# Get these values from: Firebase Console → Project Settings → Your apps → Web app SDK config
# When all VITE_FIREBASE_* vars are set, the app uses Firebase RTDB for live data.
# Without them, the app falls back to a simulated demo feed.
#
# ESP32 nodes write readings via HTTP PUT:
#   curl -X PUT https://<project-id>-default-rtdb.firebaseio.com/readings/n1.json?auth=<DB_SECRET> \
#     -H "Content-Type: application/json" \
#     -d '{"magnitudeMmS":1.2,"frequencyHz":24.5,"radialBearingDeg":142,"rssi":-68,"updatedAt":1234567890}'
#
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
