# Optional: Mapbox GL raster tiles (dark style). Without this, OpenStreetMap tiles are used (no key).
# VITE_MAPBOX_TOKEN=pk.ey...

# ── Firebase Realtime Database (recommended backend) ──────────────────────────
# Get these values from: Firebase Console → Project Settings → Your apps → Web app SDK config
# When all VITE_FIREBASE_* vars are set, the app reads live data from Firebase RTDB.
# Without them, the app falls back to a simulated demo feed.
#
# Firebase RTDB structure (written by the ESP32 firmware):
#
#   nodes/
#     n1/
#       deviceId:          "n1"
#       magnitudeMmS:      1.24
#       frequencyHz:       28.5
#       vibrationDetected: true
#       rssi:              -68
#       updatedAt:         <ServerTimestamp>
#
# Example: write a reading with the Firebase REST API (DB Secret auth):
#   curl -X PUT \
#     "https://<project-id>-default-rtdb.firebaseio.com/nodes/n1.json?auth=<DB_SECRET>" \
#     -H "Content-Type: application/json" \
#     -d '{
#           "deviceId": "n1",
#           "magnitudeMmS": 1.24,
#           "frequencyHz": 28.5,
#           "vibrationDetected": true,
#           "rssi": -68,
#           "updatedAt": { ".sv": "timestamp" }
#         }'
#
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Optional: WebSocket gateway (overrides Firebase) ─────────────────────────
# Set this to your deployed server URL to use the Node.js gateway instead.
# The gateway accepts POST /ingest with the same fields as above.
# VITE_WS_URL=ws://localhost:3000/ws
