# ── Required ───────────────────────────────────────────────────────────────────

# Port the server listens on (Railway sets this automatically)
PORT=3000

# ── Recommended ───────────────────────────────────────────────────────────────

# Shared secret for the /ingest endpoint.
# ESP32 nodes must send: Authorization: Bearer <this value>
# Leave empty to disable auth (not recommended in production).
INGEST_SECRET=change-me-to-a-strong-random-string

# Allowed CORS origins for the REST endpoints.
# Set to your deployed frontend URL (e.g. https://galamsey-monitor.vercel.app)
# Use * to allow all origins during development.
CORS_ORIGIN=*

# ── Optional ───────────────────────────────────────────────────────────────────

# How long (ms) before a node is considered "offline" if no new reading arrives.
# Default: 30000 (30 seconds)
NODE_TIMEOUT_MS=30000
